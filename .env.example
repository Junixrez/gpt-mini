# OpenAI API Key (required)
# Get your API key from: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# MongoDB Connection String (required for RAG mode)
# Get your connection string from: https://cloud.mongodb.com
MONGO_URI="mongodb+srv://username:password@cluster.mongodb.net/?appName=YourApp"

# n8n Webhook Integration (optional)
# Enable to send uploaded files to n8n workflow
N8N_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/your-webhook-id
N8N_ENABLED=false
